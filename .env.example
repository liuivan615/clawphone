# ClawPhone Environment Variables

# Authentication token (required)
# Generate any random string, then use it to login on your phone
CLAWPHONE_TOKEN=your-secret-token-here

# Server port (optional, default: 3000)
# PORT=3000

# Host binding (optional, default: 0.0.0.0)
# HOST=0.0.0.0

# Log level (optional, default: info)
# LOG_LEVEL=info
